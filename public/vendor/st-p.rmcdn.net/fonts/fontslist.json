t":["regular"],"language":["en"],"number_style":["uppercase"],"recommended_for":[],"weight":["regular"],"width":["regular"],"x_height":[]},"description":null,"foundry":"Hamilton Wood Type Foundry","lastModified":1588840822771,"name":"HWT Van Lanen","variations":["n5"],"web_link":"http://typekit.com/fonts/hwt-van-lanen"},{"id":"bxgy","__v":0,"browse_info":{"capitals":["uppercase-lowercase"],"classification":["decorative"],"contrast":["low"],"language":["ca","cs","de","en","es","fr","hu","it","mt","nl","pl","pt","sl","sv","tr"],"number_style":["uppercase"],"recommended_for":[],"weight":["regular"],"width":["condensed"],"x_height":["high"]},"description":"The Hydrophilia family was created in 2003 by Felix Braden as a further development of Moby and comes with two fonts: The gothic font (liquid) is a revised version of the pixel font (iced). Hydrophilia liquid has a lot of letterforms with a diagonal axis, which reminded me of the technical fonts used on early liquid crystal displays. That is how the font got its name. The pixel font Hydrophilia Iced is optimized for a font size of 11 Pixels.","foundry":"Floodfonts","lastModified":1588840822760,"name":"Hydrophilia Iced","variations":["n4"],"web_link":"http://typekit.com/fonts/hydrophilia-iced"},{"id":"bwvb","__v":0,"browse_info":{"capitals":["uppercase-lowercase"],"classification":["decorative"],"contrast":["low"],"language":["ca","cs","de","en","es","fr","hu","it","mt","nl","pl","pt","sl","sv","tr"],"number_style":["uppercase"],"recommended_for":[],"weight":["regular"],"width":["condensed"],"x_height":["high"]},"description":"The Hydrophilia family was created in 2003 by Felix Braden as a further development of Moby and comes with two fonts: The gothic font (liquid) is a revised version of the pixel font (iced). Hydrophilia liquid got a lot of letterforms with a diagonal axis, which reminded me of the technical fonts used on early liquid crystal displays. That is how the font got its name. The pixel font Hydrophilia Iced is optimized for a font size of 11 Pixel.","foundry":"Floodfonts","lastModified":1588840822775,"name":"Hydrophilia Liquid","variations":["n4"],"web_link":"http://typekit.com/fonts/hydrophilia-liquid"},{"id":"xstc","__v":0,"browse_info":{"capitals":["uppercase-lowercase"],"classification":["sans-serif"],"contrast":["low"],"language":["ca","cs","de","el","en","es","fr","hu","it","mt","nl","pl","pt","ru","sl","sv","tr","vi"],"number_style":["uppercase"],"recommended_for":[],"weight":["heavy","light","regular"],"width":["regular"],"x_height":["low"]},"description":"Named for the classical mathematician, Thomas Phinney’s Hypatia Sans is a geometric sans serif with humanist undertones. Hypatia echoes the basic form of geometric designs from the 1920s and '30s, and adds features derived from classical oldstyle typefaces and inscriptional lettering that give the design a balance between cold geometry and warm organic form. The letters are expressive at larger sizes, and are still clear and readable at text sizes in short paragraphs.","foundry":"Adobe Originals","lastModified":1588840822768,"name":"Hypatia Sans Pro","variations":["n2","i2","n3","i3","n4","i4","n6","i6","n7","i7","n9","i9"],"web_link":"http://typekit.com/fonts/hypatia-sans-pro"},{"id":"rmmv","__v":0,"browse_info":{"capitals":["uppercase-lowercase"],"classification":["decorative"],"contrast":["high"],"language":[],"number_style":["uppercase"],"recommended_for":[],"weight":["heavy"],"width":["extended"],"x_height":["low"]},"description":null,"foundry":"Paratype","lastModified":1588840822779,"name":"Hypocrite","variations":["n9"],"web_link":"http://typekit.com/fonts/hypocrite"},{"id":"dmrh","__v":0,"browse_info":{"capitals":[],"classification":[],"contrast":[],"language":[],"number_style":[],"recommended_for":[],"weight":[],"width":[],"x_height":[]},"description":null,"foundry":"Google","lastModified":1705021884613,"name":"Ibarra Real Nova","variations":["n4","i4","n5","i5","n6","i6","n7","i7"],"web_link":"h