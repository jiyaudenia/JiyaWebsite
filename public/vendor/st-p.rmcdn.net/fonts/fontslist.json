t":["regular"]},"description":"This font was created in collaboration with the Philadelphia Museum of Art to coincide with the Benjamin Franklin Tercentenary. It includes faithfully reproduced letterforms digitized directly from images of impressions made by Benjamin Franklin and his printing office circa 1750. The printing conditions of the time involved handmade paper with textured surfaces and handmade inks which were hand-applied for each impression. By digitizing the printed type in its real-life state, an authentic look of Franklin's actual work is achieved and, ultimately, has a timeless appeal.","foundry":"P22 Type Foundry","lastModified":1588840826798,"name":"P22 Franklin Caslon","variations":["n4","i4"],"web_link":"http://typekit.com/fonts/p22-franklin-caslon"},{"id":"pysn","__v":0,"browse_info":{"capitals":[],"classification":[],"contrast":[],"language":[],"number_style":[],"recommended_for":[],"weight":[],"width":[],"x_height":[]},"description":null,"foundry":"P22 Type Foundry","lastModified":1664759488199,"name":"P22 Freely","variations":["n4"],"web_link":"http://typekit.com/fonts/p22-freely"},{"id":"bmlx","__v":0,"browse_info":{"capitals":[],"classification":[],"contrast":[],"language":[],"number_style":[],"recommended_for":[],"weight":[],"width":[],"x_height":[]},"description":null,"foundry":"P22 Type Foundry","lastModified":1664759488214,"name":"P22 Frenzy","variations":["n4"],"web_link":"http://typekit.com/fonts/p22-frenzy"},{"id":"bsmw","__v":0,"browse_info":{"capitals":[],"classification":[],"contrast":[],"language":[],"number_style":[],"recommended_for":[],"weight":[],"width":[],"x_height":[]},"description":null,"foundry":"P22 Type Foundry","lastModified":1664759488206,"name":"P22 Glaser Babyfat Black","variations":["n4"],"web_link":"http://typekit.com/fonts/p22-glaser-babyfat-black"},{"id":"jlpt","__v":0,"browse_info":{"capitals":[],"classification":[],"contrast":[],"language":[],"number_style":[],"recommended_for":[],"weight":[],"width":[],"x_h