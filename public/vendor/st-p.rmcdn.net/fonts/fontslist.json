{"id":"fbzk","__v":0,"browse_info":{"capitals":[],"classification":[],"contrast":[],"language":[],"number_style":[],"recommended_for":[],"weight":[],"width":[],"x_height":[]},"description":null,"foundry":"Lanston Type Co.","lastModified":1664586684327,"name":"LTC Francis","variations":["n4"],"web_link":"http://typekit.com/fonts/ltc-francis"},{"id":"xnjh","__v":0,"browse_info":{"capitals":["uppercase-lowercase"],"classification":["sans-serif"],"contrast":["high"],"language":["ca","de","en","es","fr","it","nl","pt","sv"],"number_style":["uppercase"],"recommended_for":[],"weight":["heavy","regular"],"width":["regular"],"x_height":["high"]},"description":"LTC Globe Gothic was designed initially by Morris Fuller Benton, circa 1900.\r\n\r\nThe design is a refinement of Taylor Gothic from 1897. It features a sans serif thick and thin design with angular stems. Pre-dating art deco, this design feels quaint, yet it still has a touch of modernism.\r\n\r\nFrederic Goudy designed a bold version of Globe Gothic in 1905 for ATF. The Bold and Bold Italic digital versions have been added to the LTC library in early 2007.","foundry":"Lanston Type","lastModified":1588840824317,"name":"LTC Globe Gothic","variations":["n4","n7","i7"],"web_link":"http://typekit.com/fonts/ltc-globe-gothic"},{"id":"kxhd","__v":0,"browse_info":{"capitals":[],"classification":[],"contrast":[],"language":[],"number_style":[],"recommended_for":[],"weight":[],"width":[],"x_height":[]},"description":null,"foundry":"Lanston Type Co.","is_personal":false,"lastModified":1734397884195,"name":"LTC Goudy Heavyface Pro","variations":["n4","i4"],"web_link":"http://fonts.adobe.com/fonts/ltc-goudy-heavyface-pro"},{"id":"tjzj","__v":0,"browse_info":{"capitals":["uppercase-lowercase"],"classification":["serif"],"contrast":["regular"],"language":[],"number_style":["uppercase"],"recommended_for":[],"weight":["regular"],"width":["regular"],"x_height":["regular"]},"description":null,"foundry":"P22 Type Foundry","lastModified":