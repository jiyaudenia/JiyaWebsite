trast":[],"language":["ca","de","en","es","fr","it","nl","pt","ru","sv"],"number_style":["uppercase"],"recommended_for":[],"weight":[],"width":[],"x_height":[]},"description":"Based on informal lettering. In Russian ‘Zubilo’ means ‘Cold cutter’ or ‘Chisel’. Colorful letterforms seems to be cut by an amateurish but strong hand used to operate with rough metal tools, not with pen or pencil.","foundry":"Paratype","lastModified":1588840832475,"name":"Zubilo Shadow","variations":["n4"],"web_link":"http://typekit.com/fonts/zubilo-web-shadow"},{"id":"dkjq","__v":0,"browse_info":{"capitals":[],"classification":[],"contrast":[],"language":[],"number_style":[],"recommended_for":[],"weight":[],"width":[],"x_height":[]},"description":null,"foundry":"Typeland","lastModified":1679015488848,"name":"Zubtrak Stencil","variations":["n4","n9"],"web_link":"http://typekit.com/fonts/zubtrak-stencil"},{"id":"vvpy","__v":0,"browse_info":{"capitals":[],"classification":[],"contrast":[],"language":[],"number_style":[],"recommended_for":[],"weight":[],"width":[],"x_height":[]},"description":null,"foundry":"Adam Ladd","lastModified":1680311487439,"name":"Zuume","variations":["n3","i3","n4","i4","n7","i7","n9","i9"],"web_link":"http://typekit.com/fonts/zuume"},{"id":"fzlj","__v":0,"browse_info":{"capitals":[],"classification":[],"contrast":[],"language":[],"number_style":[],"recommended_for":[],"weight":[],"width":[],"x_height":[]},"description":null,"foundry":"Adam Ladd","lastModified":1680311487430,"name":"Zuume Cut","variations":["n3","i3","n4","i4","n7","i7","n9","i9"],"web_link":"http://typekit.com/fonts/zuume-cut"},{"id":"wfbc","__v":0,"browse_info":{"capitals":[],"classification":[],"contrast":[],"language":[],"number_style":[],"recommended_for":[],"weight":[],"width":[],"x_height":[]},"description":null,"foundry":"Adam Ladd","lastModified":1680311487447,"name":"Zuume Edge","variations":["n3","i3","n4","i4","n7","i7","n9","i9"],"web_link":"http://typekit.com/fonts/zuume-edge"}],"webtype":[{"browse_info":{"classification":["sans-serif"],"recommended_for":["paragraphs"],"weight":["regular","heavy"],"width":["regular"],"x_height":["regular","high"],"contrast":["low"],"language":["latin"]},"description":"David Berlow and staff drew Apres as part of a series designed originally for the Palm Pre smart phone, for use both on the device and in print marketing. Simple, open letterforms and generous proportions provide a clear, comfortable, and inviting experience for navigation and readability. The plain-spoken geometry is regular and balanced, without being static or mechanical, for a friendly and forthright familiarity; FB 2010","foundry":"Font Bureau","lastModified":1406789901938,"name":"Apres RE","variations":["n4","i4","n7","i7"],"web_link":"http://www.webtype.com/font/apresre-family/"},{"browse_info":{"classification":["serif"],"recommended_for":["paragraphs"],"weight":["regular","heavy"],"width":["regular","extended"],"x_height":["regular","high"],"contrast":["regular","high"],"language":["latin"]},"description":"Benton Modern was originally undertaken by Tobias Frere-Jones to improve text at The Boston Globe. The italic, based on Century Schoolbook Italic, was designed by Richard Lipton and Christian Schwartz, who also added the Bold. To prepare the family for the even greater rigors of screen use, David Berlow distilled the design to four styles compatible with cross-platform screen use at small sizes; FB 1997–2010","foundry":"Font Bureau","lastModified":1406789901938,"name":"Benton Modern RE","variations":["n4","i4","n7","i7"],"web_link":"http://www.webtype.com/font/bentonmodern-re-family/"},{"browse_info":{"classification":["sans-serif"],"recommended_for":["paragraphs"],"weight":["regular","heavy"],"width":["regular"],"x_height":["regular","high"],"contrast":["low"],"language":["latin"]},"description":"In 1903 faced with the welter of sans offered by ATF, Morris Fuller Benton designed News Gothic, a 20th century standard. In 1995 Tobias Frere-Jones studied drawings in the Smithsonian and started a redesign. Cyrus Highsmith reviewed News Gothic, and expansion to Benton Sans. David Berlow distilled the design to four styles of even sturdier design for screen use at small sizes: FB 1995-2010","foundry":"Font Bureau","lastModified":1406789901937,"name":"Benton Sans RE","variations":["n4","i4","n7","i7"],"web_link":"http://www.webtype.com/font/bentonsansre-family/"},{"browse_info":{"classification":["sans-serif"],"recommended_for":["paragraphs","headings"],"weight":["regular","heavy"],"width":["regular"],"x_height":["regular","high"],"contrast":["low"],"language":["latin","cyrillic"]},"description":"Calibri™ Fonts Family is part of the modern sans serif family with subtle roundings on stems and corners. Calibri was designed by Luc(as) de Groot. The Calibri fonts features real italics, small caps, and multiple numeral sets. Calibri Fonts Family's proportions allow high impact in tightly set lines of big and small text alike. Calibri's many curves and the new rasteriser team up in bigger sizes to reveal a warm and soft character. The Calibri Fonts Family is featured in the Microsoft ClearType Font Collection, a set of fonts developed to take advantage of ClearType to improve the reading experience in Windows Vista and Office 2007. NOTE: Calibri fonts are not compatible with QuarkXPress 6.5.","foundry":"Microsoft","lastModified":1406789901938,"name":"Calibri","variations":["n4","i4","n7"],"web_link":"http://www.webtype.com/font/calibri-family/"},{"browse_info":{"classification":["serif"],"recommended_for":["paragraphs"],"weight":["light","regular"],"width":["regular"],"x_height":["regular","high"],"contrast":["regular"],"language":["latin"]},"description":"German-born punchcutter Johann Fleischman, a contemporary of Baskerville and Fournier, worked at the Enschede Foundry in Haarlem. He was an expert in advanced tools and the qualities of fine steel, and pushed beyond the frontiers of his time, cutting typefaces famous worldwide for their “sparkle”. For Farnham, Christian Schwartz looked at Fleischman’s exuberant angularity, carrying it to all weights of his new series. Distinctive notches and sharp corners distinguish the design and let the text styles stay legible in small sizes down to 12px. Font Bureau, 2004.","foundry":"Font Bureau","lastModified":1406789901937,"name":"Farnham Display","variations":["n3","i3"],"web_link":"http://www.webtype.com/font/farnham-display-family/"},{"browse_info":{"classification":["serif"],"recommended_for":["paragraphs"],"weight":["regular","heavy"],"width":["regular"],"x_height":["regular","high"],"contrast":["regular"],"language":["latin"]},"description":"German-born punchcutter Johann Fleischman, a contemporary of Baskerville and Fournier, worked at the Enschede Foundry in Haarlem. He was an expert in advanced tools and the qualities of fine steel, and pushed beyond the frontiers of his time, cutting typefaces famous worldwide for their “sparkle”. For Farnham, Christian Schwartz looked at Fleischman’s exuberant angularity, carrying it to all weights of his new series. Distinctive notches and sharp corners distinguish the design and let the text styles stay legible in small sizes down to 12px. Font Bureau, 2004.","foundry":"Font Bureau","lastModified":1406789901937,"name":"Farnham Text","variations":["n4","i4","n7","i7"],"web_link":"http://www.webtype.com/font/farnham-text-family/"},{"browse_info":{"classification":["serif"],"recommended_for":["headings"],"weight":["regular","heavy"],"width":["regular"],"x_height":["regular","high"],"contrast":["regular","high"],"language":["latin"]},"description":"With an average hairline weight of just 1% of its point size, Freight Big is designed for the largest settings: openers, headlines, banners, and other large display applications. Mildly condensed proportions and tight spacing give it a bright finish. The lightest weights permit fine adjustments in the stylistic decisions on the part of the designer. The heavier weights, especially in the italics, emphasize a fundamental abruptness: for every turn, there is a corner. Garage Fonts 2005–2009","foundry":"Garage Fonts","lastModified":1406789901937,"name":"Freight Big","variations":["n5","n7","n9"],"web_link":"http://www.webtype.com/font/freight-big-family/"},{"browse_info":{"classification":["serif"],"recommended_for":["paragraphs","headings"],"weight":["regular","heavy"],"width":["regular"],"x_height":["regular","high"],"contrast":["regular"],"language":["latin","cyrillic","greek"]},"description":"Originally designed in 1996 by Matthew Carter for Microsoft as a sturdy, dependable serif type for optimal clarity in online reading, Georgia has become a familiar and trusted voice in settings both on and off the monitor. Steve Matteson added new weights, a Condensed width, multiple figure sets & small caps (all with extensive hinting by Tom Rickner), extending Georgia Pro's versatility in print as well as on screen; FB 2011","foundry":"Font Bureau","lastModified":1406789901938,"name":"Georgia Pro","variations":["n4","i4","n6","i6","n7","i7","n9"],"web_link":"http://www.webtype.com/font/georgia-pro-family-1/"},{"browse_info":{"classification":["sans-serif"],"recommended_for":["paragraphs","headings"],"weight":["light","regular","heavy"],"width":["regular"],"x_height":["regular","high"],"contrast":["low","regular"],"language":["latin","cyrillic"]},"description":"Gill Sans™ Family was first introduced in 1928. Eric Gill studied under the renowned calligrapher, Edward Johnston, the designer of the London Underground sans serif typeface. This influenced Gill who later experimented with sans serif designs, and in due course produced a set of capital letters. Gill Sans Fonts Family is a twentieth century sans serif that has a simplicity of form which does not reject traditional forms and proportions, and gives the Gill Sans font face a humanist feel. The Gill Sans fonts lighter weights are highly readable in text and suitable for magazine and book work, whereas the heavier weights are best used for display in advertising, packaging, and labels. Gill Sans Fonts Character Set: Latin-1, WGL Pan-European (Eastern Europe, Cyrillic, Greek and Turkish).","foundry":"Monotype","lastModified":1406789901937,"name":"Gill Sans","variations":["n3","n4","i4","n7"],"web_link":"http://www.webtype.com/font/gill-sans-family/"},{"browse_info":{"classification":["sans-serif"],"recommended_for":["paragraphs","headings"],"weight":["regular","heavy"],"width":["regular"],"x_height":["regular","high"],"contrast":["low"],"language":["latin","cyrillic"]},"description":"Characteristics about News Gothic™ Family: Sans serif faces can get very boring and can be difficult to read. One of the primary reasons is that font designers cannot make many variations in the shape of a sans serif letter, particularly those like 'l', 'i' and 'o'. News Gothic™ Family, however, has a nice angularity that allows it to wear better than most, and you will find it a pleasant change from the other sans serif typefaces of this world. Originally designed in 1908, News Gothic preceded the more fiercely geometric forms of the twentieth century. This design, with its plainly stated, unselfconscious letterforms, was revived in 1962. You'll find it useful as a text face, but it's quite nice for headlines and section headings as well. Character Set: Latin-1, WGL Pan-European (Eastern Europe, Cyrillic, Greek and Turkish).","foundry":"Monotype","lastModified":1406789901938,"name":"News Gothic","variations":["n4","i4","n7","i7"],"web_link":"http://www.webtype.com/font/news-gothic-family/"},{"browse_info":{"classification":["serif","monospaced"],"recommended_for":["paragraphs"],"weight":["regular","heavy"],"width":["regular"],"x_height":["high"],"contrast":["low"],"language":["latin","cyrillic","greek"]},"description":"Nitti is a monospaced typefamily that has its roots in the first sans serif designs of the 19th century. Originally a British invention, the quirky and often idiosyncratic shapes of these “grotesque” designs lend them a humanity and warmth that is still appreciated among many graphic designers today. Unusually rich in features for a monospaced design, Nitti offers a generous 657 characters per font and broad support for all European language, Greek, and most Asian languages that use the Cyrillic script. Bold Monday, 2012","foundry":"Bold Monday","lastModified":1406789901938,"name":"Nitti","variations":["n3","i3","n5"],"web_link":"http://www.webtype.com/font/nitti-family/"},{"browse_info":{"classification":["sans-serif"],"recommended_for":["paragraphs","headings"],"weight":["light","regular","heavy"],"width":["regular"],"x_height":["low","regular"],"contrast":["low"],"language":["latin"]},"description":"Nobel offers personal variations on strict Bauhaus geometry. In 1929, three years after the Futura release, Sjoerd Henrik de Roos at Amsterdam explored alternative character sets to enliven basic Futura forms. The Nobel series was designed for Font Bureau by Tobias Frere-Jones, who fondly views Nobel as ‘Futura cooked in dirty pots & pans.’ The Extra Lights were added by Cyrus Highsmith & Dyana Weissman; FB 1993–2003","foundry":"Font Bureau","lastModified":1406789901937,"name":"Nobel","variations":["n2","n3","i3","n4","i4","n7"],"web_link":"http://www.webtype.com/font/nobel-family/"},{"browse_info":{"classification":["serif"],"recommended_for":["paragraphs","headings"],"weight":["regular","heavy"],"width":["regular"],"x_height":["regular","high"],"contrast":["regular"],"language":["latin"]},"description":"The Parkinson display family was originally designed during the mid-seventies by Jim Parkinson for Roger Black at a growing Rock & Roll magazine. Jim sees it as “a combination between the original logo by San Francisco poster artist Rick Griffin & ATF Jenson,” remembering it fondly as “a sort of Nicholas Jenson on acid.” Growing success of the series followed the rise of the magazine, with widths and weights being added year after year. Font Bureau, 1994","foundry":"Font Bureau","lastModified":1406789901938,"name":"Parkinson","variations":["n4","i4","n5","n7"],"web_link":"http://www.webtype.com/font/parkinson-family/"},{"browse_info":{"classification":["sans-serif"],"recommended_for":["paragraphs"],"weight":["regular","heavy"],"width":["regular"],"x_height":["high"],"contrast":["low"],"language":["latin"]},"description":"Related to the Scout family, a sans serif Cyrus Highsmith originally drew for Entertainment Weekly, Scout RE is of even sturdier design, optimized for extra small sizes onscreen. Though it shares the typically tall x-height and features of our Reading Edge series, Scout RE slightly narrower than the other RE sans serifs. Large, oval counters—inspired by typefaces such as DIN, Venus, and Cairoli—contribute to excellent readability on screen. Its generous spacing and similar proportions make Scout RE a perfect fit to Highsmith’s Ibis RE. Font Bureau, 2012","foundry":"Font Bureau","lastModified":1406789901937,"name":"Scout RE","variations":["n4","i4","n7","i7"],"web_link":"http://www.webtype.com/font/scout-re-family/"},{"browse_info":{"classification":["sans-serif"],"recommended_for":["paragraphs","headings"],"weight":["light","regular","heavy"],"width":["extended"],"x_height":["high"],"contrast":["low"],"language":["latin"]},"description":"Sweet Sans is a masterful revival of an old classic: the engraver’s sans serif. The model has been one of the most widely used stationer’s lettering styles since about 1900. There are digital fonts based on this style, but none come near the versatility of Sweet Sans with its 18 webfonts: nine weights, from Hairline to Heavy, each with a complete character set and a true italic. While rich in history, Sweet Sans is made for contemporary use. It is a handsome and functional tribute to the spirit of unsung craftsmanship; Sweet® 2011.","foundry":"Sweet","lastModified":1406789901937,"name":"Sweet Sans","variations":["n3","n4","i4","n5","n7"],"web_link":"http://www.webtype.com/font/sweet-sans-family/"},{"browse_info":{"classification":["sans-serif"],"recommended_for":["paragraphs","headings"],"weight":["regular","heavy"],"width":["regular"],"x_height":["regular"],"contrast":["low"],"language":["latin"]},"description":"The lettering of the word TELEFON on old Norwegian phone booths inspired Sindre Bremnes to draw a geometric typeface. Bremnes incorporated the “low waist” of the capitals and spiky vertices of his model into his design, but all other characters are drawn from scratch to fit the style of constructed letterforms from the 1930s in general. We recommend Telefon for short texts in medium sizes or display typography; the black weight makes for especially punchy headlines. Monokrom, 2012. View the Monokrom catalogue specimen site.","foundry":"Monokrom","lastModified":1406789901938,"name":"Telefon","variations":["n4","n7"],"web_link":"http://www.webtype.com/font/telefon-family/"},{"browse_info":{"classification":["sans-serif"],"recommended_for":["paragraphs","headings"],"weight":["regular","heavy"],"width":["extended"],"x_height":["high"],"contrast":["low"],"language":["latin"]},"foundry":"Bold Monday","lastModified":1406789901937,"name":"Trio Grotesk","variations":["n4","n5"],"web_link":"http://www.webtype.com/font/trio-grotesk-family/"}],"typetoday":[{"name":"Austin","foundry":"Paul Barnes, Commercial Type, Ilya Ruderman","browse_info":{"classification":["serif"],"recommended_for":["paragraphs","headings"],"weight":["regular","heavy"],"width":["regular","extended"],"x_height":["low","regular"],"contrast":["regular","high"],"language":["ca","cs","de","en","es","fr","it","nl","pl","pt","ru","sv","sl"],"capitals":["uppercase-lowercase"],"number_style":["lowercase"]},"description":"Originally designed by Paul Barnes as headline type for the British magazine of fashion Harper’s & Queen, of Hearst Magazines UK, Austin is a loose revival of the typefaces cut by Richard Austin in the late 18th century.","web_link":"https://type.today/en/austin","lastModified":1604408484398,"variations":["n4","i4","n6","i6","n7","i7","n8","n9","i9"],"custom_variation_names":{"n4":"Roman","i4":"Roman Italic","n8":"Fat","n9":"Ultra","i9":"Ultra Italic"},"deprecated_variations":["n6","n9","i9"]},{"name":"Dala Floda","foundry":"Paul Barnes, Ilya Ruderman","browse_info":{"classification":["serif"],"recommended_for":["paragraphs","headings"],"weight":["regular","heavy"],"width":["regular","extended"],"x_height":["low","regular"],"contrast":["regular","high"],"language":["ca","cs","de","en","es","fr","it","nl","pl","pt","ru","sv","sl"],"capitals":["uppercase-lowercase"],"number_style":["lowercase"]},"description":"Dala Floda has its roots in the typefaces of the Renaissance but adds the twist of being a stencil letterform. Originally inspired by worn gravestone lettering and lettering on shipping crates, the elegance of the forms belies their everyday origins.","web_link":"https://type.today/en/dala_floda","lastModified":1604408484398,"variations":["n8"],"custom_variation_names":{"n8":"Fat"},"__v":0,"deprecated":true},{"name":"Druk Condensed","foundry":"Ilya Ruderman, Yury Ostromentsky, Berton Hasebe","browse_info":{"classification":["serif"],"recommended_for":["paragraphs","headings"],"weight":["regular","heavy"],"width":["regular","extended"],"x_height":["low","regular"],"contrast":["regular","high"],"language":["ca","cs","de","en","es","fr","it","nl","pl","pt","ru","sv","sl"],"capitals":["uppercase-lowercase"],"number_style":["lowercase"]},"description":"Of the families in the Druk collection, Druk Condensed Cyrillic is the most explicit homage to Willy Fleckhaus. Originally designed for the 2011 “Year in Review” issue of Bloomberg Businessweek, its flat sides make letters and words snap together in a clean and satisfying way.","web_link":"https://type.today/en/druk_cond","lastModified":1605000119679,"variations":["n8","n9"],"custom_variation_names":{"n8":"X Super","n9":"Super"},"__v":0},{"name":"Druk Wide","foundry":"Ilya Ruderman, Yury Ostromentsky, Berton Hasebe","browse_info":{"classification":["serif"],"recommended_for":["paragraphs","headings"],"weight":["regular","heavy"],"width":["regular","extended"],"x_height":["low","regular"],"contrast":["regular","high"],"language":["ca","cs","de","en","es","fr","it","nl","pl","pt","ru","sv","sl"],"capitals":["uppercase-lowercase"],"number_style":["lowercase"]},"description":"Designed for the 2013 retooling of the style and culture-focused Etc. section of Bloomberg Businessweek, Druk Wide is first and foremost an homage to the way Dutch graphic designers of the early- to mid-20th century commonly used wide, bold sans serifs to add a strong typographic hierarchy to their work, including Willem Sandberg’s catalogs for the Stedelijk Museum in Amsterdam.","web_link":"https://type.today/en/druk_wide","lastModified":1605179735168,"variations":["n7","n9"],"custom_variation_names":{"n9":"Super"},"__v":0},{"name":"Giorgio Sans","foundry":"Vincent Chan, Christian Schwartz, Commercial Type, Ilya Ruderman","browse_info":{"classification":["sans-serif"],"recommended_for":["paragraphs","headings"],"weight":["light","regular","heavy"],"width":["condensed"],"x_height":["high"],"contrast":["low"],"language":["ca","cs","en","es","fr","it","nl","pl","pt","ru","sv","sl"],"capitals":["uppercase-lowercase"],"number_style":["lowercase"]},"description":"Giorgio Sans was created in 2008 by Christian Schwartz for Christopher Martinez, art director for the New York Times’ style magazine, T. The heaviest weights were added a few years later, bringing power to the family.","web_link":"https://type.today/en/giorgiosans","lastModified":1604408484398,"variations":["n1","n4","i4","n5","n7","i7","n8","n9"],"custom_variation_names":{"n8":"Heavy"},"deprecated_variations":["i4","n5","i7","n9"],"deprecated":true},{"name":"Graphik","foundry":"Christian Schwartz, Commercial Type, Ilya Ruderman","browse_info":{"classification":["sans-serif"],"recommended_for":["paragraphs","headings"],"weight":["light","regular","heavy"],"width":["regular"],"x_height":["regular"],"contrast":["low","regular"],"language":["ca","cs","en","es","fr","it","nl","pl","pt","ru","sv","sl"],"capitals":["uppercase-lowercase"],"number_style":["uppercase"]},"description":"Graphik was inspired by the appealing plainness seen in many of the less common 20th century European sans serifs and in the hand-lettering of classic Swiss Modern posters. The lighter weights were influenced by the less popular sans serifs that many European foundries released to compete with Futura, Helvetica and Univers, the juggernauts of 20th century sans serifs. These influences included Neuzeit Grotesk, Folio, Recta, and Maxima. The heavy end of the family is inspired in part by Paul Renner’s Plak, a relatively obscure display typeface cut only in large sizes.","web_link":"https://type.today/en/Graphik","lastModified":1604408484398,"variations":["n1","n2","n3","n4","i4","n5","i5","n7","i7","n8","n9"],"custom_variation_names":{"n8":"Black","n9":"Super"},"deprecated_variations":["n1","n8"]},{"name":"Karloff Negative","foundry":"Peter Biľak, Pieter van Rosmalen, Nikola Djurek, Maria Doreuli","browse_info":{"classification":["serif"],"recommended_for":["paragraphs","headings"],"weight":["regular","heavy"],"width":["regular","extended"],"x_height":["low","regular"],"contrast":["regular","high"],"language":["ca","cs","de","en","es","fr","it","nl","pl","pt","ru","sv","sl"],"capitals":["uppercase-lowercase"],"number_style":["lowercase"]},"description":"Karloff explores the idea of irreconcilable differences, how two extremes could be combined into a coherent whole. At the start we looked at the high-contrast Didone typefaces which are considered by many as some of the most beautiful in existence, and the eccentric ‘Italian’, reversed-contrast typeface was designed to deliberately attract readers’ attention by defying their expectations. No other style in the history of typography has provoked such negative reactions as the Italian.","web_link":"https://type.today/en/karloff_negative","lastModified":1604408484398,"variations":["n4","n7"],"custom_variation_names":{},"__v":0,"deprecated":true},{"name":"Kazimir","foundry":"CSTM Fonts, Yury Ostromentsky, Ilya Ruderman","browse_info":{"classification":["serif"],"recommended_for":["paragraphs","headings"],"weight":["regular","heavy"],"width":["condensed","regular"],"x_height":["low","regular"],"contrast":["low","regular","high"],"language":["cs","en","es","fr","it","nl","pl","pt","ru","sv","sl"],"capitals":["uppercase-lowercase"],"number_style":["lowercase"]},"description":"Kazimir is a Modern serif style typeface with five weights, from light to bold, with matched italics. The face has slightly narrowed proportions, long extenders and dynamic strokes reminiscent of the rhythms of transitional serifs. Kazimir is a reworking of book typography of the late 19th and early 20th centuries and specifically of the typeface used in the book, History of Russian Literature, by P. N. Polevoy, published by A. F. Marks in 1900. Kazimir blends various features of pre-revolutionary Russian typography with contemporary ideas of fashion, form and harmony.","web_link":"https://type.today/en/kazimir","lastModified":1604408484398,"variations":["n4","n5","n7","n9"],"deprecated_variations":["n9"],"deprecated":true},{"name":"Kazimir Text","foundry":"CSTM Fonts, Yury Ostromentsky, Ilya Ruderman","browse_info":{"classification":["serif"],"recommended_for":["paragraphs"],"weight":["light","regular"],"width":["regular"],"x_height":["low","regular"],"contrast":["low","regular"],"language":["ca","cs","de","en","es","fr","it","nl","pl","pt","ru","sv","sl"],"capitals":["uppercase-lowercase"],"number_style":["uppercase"]},"description":"Kazimir Text is a Modern serif typeface with a quite simple graphic idea. It is a Text version of display Kazimir typeface. Kazimir Text has a bit wider proportions, a bit lower contrast and much wider codepage with extended language support compare to Kazimir. A set of stylistic alternatives called Irregular was also reconsidered — they became also more suitable for text usage.","web_link":"https://type.today/en/kazimir-text","lastModified":1604408484398,"variations":["n1","n3","n4","n7"],"custom_variation_names":{"n1":"Hairline","n3":"Book"},"deprecated_variations":["n1","n3"],"deprecated":true},{"name":"Marlene","foundry":"Nikola Djurek, Ilya Ruderman, Hrvoje Živčić","browse_info":{"classification":["serif"],"recommended_for":["paragraphs","headings"],"weight":["regular","heavy"],"width":["regular","extended"],"x_height":["low","regular"],"contrast":["regular","high"],"language":["ca","cs","de","en","es","fr","it","nl","pl","pt","ru","sv","sl"],"capitals":["uppercase-lowercase"],"number_style":["lowercase"]},"description":"Marlene is an elegant, high contrast Egyptian face with a distinctive and contemporary calligraphic flourish. The Roman version with its robust square vertical serifs delivers a sense of vitality and rigorousness. The italic is sharp and fast-paced with elegant, thin upstrokes and unusually high connection points of curves to stems. Together, these styles add to the appealing character of Marlene making it an ideal choice for books and magazines.","web_link":"https://type.today/en/marlene","lastModified":1604408484398,"variations":["n3","n7"],"custom_variation_names":{},"__v":0,"deprecated":true},{"name":"Navigo","__v":0,"browse_info":{"classification":["sans-serif"],"recommended_for":["paragraphs","headings"],"weight":["light","regular","heavy"],"width":["regular"],"x_height":["regular"],"contrast":["low"],"language":["af","az","ba","be","bg","ca","ce","cv","cs","da","nl","en","es","eo","et","fi","fr","gd","gl","de","hu","is","it","kk","ku","ky","lv","lt","ro","mn","no","pl","pt","ru","sr","sl","sv","tg","tt","tr","tk","uk","uz"],"capitals":["uppercase-lowercase"],"number_style":["uppercase","lowercase"]},"description":"Navigo was originally designed for the way-finding system and visual identity of the Moscow City District. A geometric sans with low contrast, its characters are of contemporary proportions and a large code page is provided. The Navigo case has extended Latin and Cyrillic, tabulated, majuscule and minuscule figures, fractions and navigational pictograms. It is suitable for both text and display typesettings.","foundry":"CSTM Fonts, Yury Ostromentsky, Ilya Ruderman","lastModified":1604408484398,"variations":["n1","n3","n4","n7","n9"],"web_link":"https://type.today/en/navigo"},{"name":"Nekst","__v":0,"browse_info":{"classification":["sans-serif"],"recommended_for":["paragraphs","headings"],"weight":["light","regular","heavy"],"width":["regular"],"x_height":["regular"],"contrast":["low"],"language":["af","be","bg","cs","da","en","es","et","fi","fr","gd","gl","de","hu","is","it","ku","lv","lt","mn","no","pl","pt","ro","ru","sl","sv","tr","uk","uz"],"capitals":["uppercase-lowercase"],"number_style":["uppercase","lowercase"]},"description":"Nekst looks like a regular geometric sans, coarse and simple, as if made of metal tubes. The first impression, though, may be misleading: the many alternate glyphs turn a most usual typeset into something unexpected and eccentric, bringing a strong futuristic taste with some hints of old-time grotesques to the austere and modern image. Seven weights, from Thin to Black.","foundry":"Denis Serebryakov","lastModified":1604408484398,"variations":["n1","n4","n6","n9"],"web_link":"https://type.today/en/nekst"},{"name":"NWT Bodoni","foundry":"Elena Novoselova","browse_info":{"classification":["serif"],"recommended_for":["paragraphs","headings"],"weight":["regular"],"width":["regular","heavy"],"x_height":["regular"],"contrast":["regular","high"],"language":["de","en","es","fr","it","pt","ru","sv","sl"],"capitals":["uppercase-lowercase"],"number_style":["lowercase"]},"description":"NWT Bodoni is based on the letters as drawn in Manuale Tipografico, the book by punch-cutter and publisher Giambattista Bodoni. For Bodoni NWT, only the drawings of 9-12-point letters were used.","web_link":"https://type.today/en/nwtbodoni","lastModified":1406789901937,"variations":["n4","i4","n7"]},{"name":"Parmigiano Text Pro","__v":0,"browse_info":{"classification":["sans-serif"],"recommended_for":["paragraphs"],"weight":["regular","heavy"],"width":["regular"],"x_height":["regular"],"contrast":["high"],"language":["af","sq","az","ba","be","bg","ca","ce","cv","hr","cs","da","nl","en","es","eo","et","fi","fr","gd","gl","de","hu","is","it","kk","ku","ky","lv","lt","mn","no","pl","pt","ro","ru","sr","sk","sl","sv","tg","tt","tr","tk","uk","uz"],"capitals":["uppercase-lowercase"],"number_style":["uppercase","lowercase"]},"description":"Parmigiano Typographic System (named after Parma, the city where Bodoni established his printing house) has the stated ambition to be the most extensive family of fonts ever to have been inspired by Giambattista Bodoni. Parmigiano Text has a delicacy which contrasts with the Piccolo version and it is more solid than the Headline cut. Highly versatile, it is an ideal choice for setting magazines, books or any other long texts whose contents need to be easily accessible. Designed for smooth readability, its sharp and elegant letterforms make for a comfortable, relaxed reading experience, while its thin, horizontal serifs, vertical axes and the round terminations on certain lowercase letters give it a thoroughly contemporary feel. Compared with the continuous text typefaces cut by Bodoni himself, Parmigiano Text has a higher contrast and a less eccentric structure. While it retains a certain distinction, eye-catching details more suited for display purposes have been softened in order to offer a more neutral effect, making it the easiest to use of the Parmigiano fonts. It is recommended for use in sizes 10 points or larger; sizes smaller than 10 points are adeptly handled by Parmigiano Caption, which was designed for this purpose. The Parmigiano Type Family family was published in 2014, designed by Riccardo Olocco and Jonathan Pierini. The Cyrillic version was designed by Ilya Ruderman and Irina Smirnova. The Greek version was designed by Irene Vlachou, in 2015.","foundry":"Typotheque, Jonathan Pierini, Riccardo Olocco, Ilya Ruderman, Irina Smirnova (cyr), Irene Vlachou (greek)","lastModified":1731502518946,"variations":["n4","n9"],"web_link":"https://type.today/en/collection/parmigiano_collection","deprecated":true},{"name":"Proto Grotesk","__v":0,"browse_info":{"classification":["sans-serif"],"recommended_for":["paragraphs","headings"],"weight":["light","regular"],"width":["regular"],"x_height":["regular"],"contrast":["regular"],"language":["af","sq","az","ba","be","bg","ca","ce","cv","hr","cs","da","en","es","eo","et","fi","fr","gd","gl","de","hu","is","it","kk","ku","ky","lv","lt","mn","nl","no","pl","pt","ro","ru","sr","sk","sl","sv","tg","tt","tr","tk","uk","uz"],"capitals":["uppercase-lowercase"],"number_style":["uppercase","lowercase"]},"description":"Over the last hundred years or so, utilitarian typefaces have shed most of their quirks and eccentricities on the way to becoming more versatile and universal. That makes some sense, but there’s no reason type can’t be both steadfast and peculiar. Drawing from an early German sans serif used for catalog text, Proto Grotesk revives an era when clunkiness was a virtue. Its pedigree is varied, vacillating between Egyptian and Modern, round and edged, even sans and slab. Despite these contradictions, its posture is nothing less than sturdy and forthright. Proto Grotesk is strange but steady.","foundry":"Production Type, CSTM Fonts, Jean-Baptiste Levée, Ilya Ruderman, Yury Ostromentsky, team: Yoann Minet, Hugues Gentile, Emilios Theofanous","lastModified":1604408484398,"variations":["n2","n3","n4","n7"],"web_link":"https://type.today/en/protogrotesk"},{"name":"Sauber Script","__v":0,"browse_info":{"classification":["script"],"recommended_for":["paragraphs","headings"],"weight":["regular"],"width":["regular"],"x_height":["regular"],"contrast":["regular"],"language":["ab","af","az","ba","be","bg","ca","ce","cv","cs","da","en","es","eo","et","fi","fr","gd","gl","de","hu","is","it","kk","ku","ky","lv","lt","mn","nl","no","pl","pt","ro","ru","sr","sl","sv","tg","tt","tr","tk","uk","uz"],"capitals":["uppercase-lowercase","all-or-small-caps"],"number_style":["uppercase","lowercase"]},"description":"Whether on fresh buttermilk, or a Honolulu surfer bar, this script face is versatile and full of character. It is a contemporary and convenient tool equipped with ligatures, alternatives, arrows, and underlining. Sauber Script supports many languages, including an extended Cyrillic and Greek set.","foundry":"Michael Hochleitner, Typejockeys, Ilya Ruderman, CSTM Fonts","lastModified":1604408484398,"variations":["i4"],"web_link":"https://type.today/en/sauberscript"},{"name":"Spektra","__v":0,"browse_info":{"classification":["sans-serif"],"recommended_for":["paragraphs","headings"],"weight":["regular"],"width":["condensed"],"x_height":["regular"],"contrast":["regular"],"language":["af","be","bg","cs","da","en","es","et","fi","fr","gd","gl","de","hu","is","it","ku","lv","lt","mn","no","pl","pt","ro","ru","sr","sl","sv","tr","uk","uz"],"capitals":["uppercase-lowercase"],"number_style":["lowercase"]},"description":"Spektra is a reasonably ironical display variable font, ranging from backslant to italic axis. The family supports many script systems other than Latin and Cyrillic, including Hebrew, Arabic, and Greek. The multilinguality of this typeface defines its character — democratic and cosmopolitan, it combines the specifics of many different scripts.","foundry":"Type Salon, Alja Herlah, Krista Likar","lastModified":1605179735168,"variations":["n4"],"web_link":"https://type.today/en/spektra","variable":"variable"},{"name":"Stratos","foundry":"Yoann Minet, Ilya Ruderman, Yury Ostromentsky","browse_info":{"classification":["serif"],"recommended_for":["paragraphs","headings"],"weight":["regular","heavy"],"width":["regular","extended"],"x_height":["low","regular"],"contrast":["regular","high"],"language":["ca","cs","de","en","es","fr","it","nl","pl","pt","ru","sv","sl"],"capitals":["uppercase-lowercase"],"number_style":["lowercase"]},"description":"A family that rethinks concepts of weight and width, spanning multiple hierarchies within a single style. Stratos is a geometric grotesque whose peculiar utility is derived from unusual ideas about proportion. It eschews conventional notions of typographic relationships — not just for novel effect, but to empower the user to do more interesting things with type.","web_link":"https://type.today/en/stratos_cyrillic","lastModified":1605000119679,"variations":["n3","n4","i4","n5","n7"],"custom_variation_names":{},"__v":0,"deprecated":true}]});